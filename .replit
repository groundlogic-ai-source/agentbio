modules = ["nodejs-24", "python-3.11", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "cloudrun"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "repodb-validation"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "repodb-smallmol-validation"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "benchmark-run"

[[workflows.workflow]]
name = "repodb-validation"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd /home/runner/workspace && python3 -m validation.run_repodb_cases 2>&1 | tee /tmp/repodb_val.log"

[[workflows.workflow]]
name = "repodb-smallmol-validation"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd /home/runner/workspace && python3 -m validation.run_repodb_cases_smallmol 2>&1 | tee /tmp/smallmol_val.log"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "benchmark-run"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd /home/runner/workspace && while true; do python3 -m validation.run_benchmark 2>&1 | tee -a /tmp/benchmark_run.log; rc=${PIPESTATUS[0]}; if [ $rc -eq 0 ]; then echo 'BENCHMARK COMPLETE' | tee -a /tmp/benchmark_run.log; break; fi; if [ $rc -eq 2 ]; then echo 'FREEZE VIOLATION — manual intervention required' | tee -a /tmp/benchmark_run.log; break; fi; echo \"halted rc=$rc — health-gated retry in 5 min\" | tee -a /tmp/benchmark_run.log; sleep 300; done"

[workflows.workflow.metadata]
outputType = "console"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"
packages = ["cairo", "catch2", "comic-neue", "coordgenlibs", "eigen", "glibcLocales", "inchi", "maeparser", "rapidjson"]
