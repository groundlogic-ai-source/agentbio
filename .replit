modules = ["nodejs-24", "python-3.11", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "cloudrun"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "repodb-validation"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "repodb-smallmol-validation"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "v2-engineering-acceptance"

[[workflows.workflow]]
name = "repodb-validation"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd /home/runner/workspace && python3 -m validation.run_repodb_cases 2>&1 | tee /tmp/repodb_val.log"

[[workflows.workflow]]
name = "repodb-smallmol-validation"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd /home/runner/workspace && python3 -m validation.run_repodb_cases_smallmol 2>&1 | tee /tmp/smallmol_val.log"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "v2-engineering-acceptance"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd /home/runner/workspace && python3 -m validation.run_v2_engineering_acceptance --fresh --cap 10 2>&1 | tee /tmp/v2_engineering_acceptance.log"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"
packages = ["cairo", "catch2", "comic-neue", "coordgenlibs", "eigen", "glibcLocales", "inchi", "maeparser", "rapidjson"]
