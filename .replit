modules = ["nodejs-24", "python-3.11", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "vm"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "repodb-validation"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "repodb-smallmol-validation"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "v2-engineering-acceptance"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "build-audit-claimset-v2"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "audit-claimset-v2-run"

[[workflows.workflow]]
name = "await-pubchem-harvest"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd /home/runner/workspace && python3 -m validation.await_pubchem_and_harvest --max-hours 12 2>&1 | tee /tmp/await_pubchem.log"

[nix]
channel = "stable-25_05"

